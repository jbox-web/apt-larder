# Ignore generated data
/docs/
/lib/
/dist/

# Assembled by scripts/harvest-licenses.sh from licenses.manifest,
# licenses-spdx/ and licenses-upstream/, all of which are tracked.
/licenses/

# Ignore all bin files
/bin/*
!/bin/.keep

# Ignore MacOS files
.DS_Store

# Ignore spectator's failing-example cache
/.spectator-failures

# Ignore apt-larder runtime data
/cache/
/logs/

# Ignore config file
apt-larder.yml
